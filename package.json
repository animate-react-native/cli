{
  "name": "@animatereactnative/cli",
  "description": "AnimateReactNative.com CLI",
  "author": "Catalin Miron <mironcatalin@gmail.com> (https://www.animatereactnative.com/)",
  "license": "MIT",
  "version": "0.0.15",
  "bin": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "components",
    "ui",
    "react-native",
    "animations",
    "react-native-reanimated",
    "animate-react-native"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "clean": "rimraf dist",
    "cli": "bun run src/index.ts",
    "pub": "bun run build && bun publish --access public"
  },
  "dependencies": {
    "chalk": "^5.0.0",
    "chalk-extra": "^0.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.1",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.3",
    "node-fetch": "^3.3.2",
    "open": "^10.0.0",
    "prompts": "^2.4.2",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/prompts": "^2.4.9",
    "@types/qrcode-terminal": "^0.12.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/animate-react-native/cli.git"
  },
  "bugs": {
    "url": "https://github.com/animate-react-native/cli/issues"
  },
  "homepage": "https://github.com/animate-react-native/cli#readme"
}
